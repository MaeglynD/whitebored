{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whitebored",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": { "SHARING_ENABLED": "true" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "whitebored.app", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SharedRoom" },
      { "name": "SHARE_LIMITS", "class_name": "ShareLimits" },
      { "name": "MEDIA_BUDGET", "class_name": "MediaBudget" },
    ],
  },
  "migrations": [{ "tag": "v1-sharing", "new_sqlite_classes": ["SharedRoom", "ShareLimits", "MediaBudget"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "whitebored-media" }],
}

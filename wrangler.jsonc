{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whitebored",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "routes": [{ "pattern": "whitebored.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
